# Telegram
TELEGRAM_BOT_TOKEN=your_token_here
TG_CHAT_ID=123456789

# Дополнительные разрешённые чаты (если нужно больше одного; иначе достаточно TG_CHAT_ID)
TG_ALLOWED_CHAT_IDS=

# Прокси для Telegram: api.telegram.org недоступен из части российских сетей.
# Примеры: socks5://127.0.0.1:1080 или http://user:pass@proxy.example:3128
TG_PROXY=

# Режим без отправки в Telegram: дайджест печатается в консоль
DRY_RUN=false

# GitHub API (для увеличения rate limit поиска: 10 → 30 req/min)
GITHUB_TOKEN=ghp_xxx

# DeepSeek (опционально)
# Доступные id моделей: deepseek-flash, deepseek-v4-pro (id deepseek-chat больше не отдаётся)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-flash

# Прочее
DB_PATH=data/aggregator.db
LOG_LEVEL=INFO
LOG_FILE=logs/collector.log
TZ=Europe/Moscow
